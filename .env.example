# Copy to repository-root .env only if absent. Never commit secrets.
FINASSIST_ENV=dev
FINASSIST_MODEL_PROVIDER=fake
FINASSIST_MODEL_API_KEY=
# Project-recorded identifiers; verify availability for your provider account.
FINASSIST_EXTRACTION_MODEL=claude-haiku-5-5
FINASSIST_CHAT_MODEL=claude-sonnet-5-5
FINASSIST_DEFAULT_TIMEZONE=Asia/Bangkok
# dev_server.py configures per-profile DB roles, local storage and embedded worker.
# Standalone deployments must explicitly configure their restricted DB/worker URLs.
# Evaluation defaults below are not a global spending cap for live chat.
FINASSIST_BUDGET_USD=1.0
FINASSIST_MAX_MODEL_REQUESTS=120
