# Copy to .env (gitignored). Never commit real values.
FINASSIST_ENV=dev
FINASSIST_DATABASE_URL=postgresql://finassist:finassist@localhost:55432/finassist
FINASSIST_STORAGE_DIR=./var/uploads
# fake | <provider name once decision D2 is made>
FINASSIST_MODEL_PROVIDER=fake
FINASSIST_MODEL_API_KEY=
FINASSIST_DEFAULT_TIMEZONE=Asia/Bangkok
# Disposable database for tests; name MUST end with _test (tests drop the public schema)
TEST_DATABASE_URL=postgresql://finassist:finassist@localhost:55432/finassist_test
